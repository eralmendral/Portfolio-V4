    {
      "name": "Project Images",
      "auth": {
        "type": "bearer",
        "bearer": [
          {
            "key": "token",
            "value": "{{jwt_token}}",
            "type": "string"
          }
        ]
      },
      "item": [
        {
          "name": "Upload Main Image",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"main image uploaded\", function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "if (body.main_image && body.main_image.id) {",
                  "  pm.collectionVariables.set(\"image_id\", body.main_image.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "image",
                  "type": "file",
                  "src": "{{main_image_path}}"
                },
                {
                  "key": "alt_text",
                  "value": "Uploaded main image",
                  "type": "text"
                },
                {
                  "key": "caption",
                  "value": "Uploaded through Postman",
                  "type": "text"
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/projects/{{project_id}}/images/main",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "projects",
                "{{project_id}}",
                "images",
                "main"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Upload Gallery Image",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"gallery image uploaded\", function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "const images = body.images || [];",
                  "if (images.length > 0) {",
                  "  pm.collectionVariables.set(\"image_id\", images[images.length - 1].id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "images",
                  "type": "file",
                  "src": "{{gallery_image_path}}"
                },
                {
                  "key": "alt_text",
                  "value": "Uploaded gallery image",
                  "type": "text"
                },
                {
                  "key": "caption",
                  "value": "Gallery image uploaded through Postman",
                  "type": "text"
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/projects/{{project_id}}/images",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "projects",
                "{{project_id}}",
                "images"
              ]
            }
          },
          "response": []
