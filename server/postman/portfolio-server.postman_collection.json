  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/healthz",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "healthz"
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"login succeeded\", function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "if (body.token) {",
                  "  pm.collectionVariables.set(\"jwt_token\", body.token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{admin_username}}\",\n  \"password\": \"{{admin_password}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Projects",
      "auth": {
        "type": "bearer",
        "bearer": [
          {
            "key": "token",
            "value": "{{jwt_token}}",
            "type": "string"
          }
        ]
      },
      "item": [
        {
          "name": "List Projects",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/projects",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "projects"
              ],
              "query": [
                {
                  "key": "status",
                  "value": "{{project_status}}",
                  "disabled": true
                },
                {
                  "key": "featured",
                  "value": "true",
                  "disabled": true
                },
                {
                  "key": "q",
                  "value": "{{project_search}}",
                  "disabled": true
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Create Project",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"project created\", function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "if (body.id) {",
                  "  pm.collectionVariables.set(\"project_id\", body.id);",
                  "}",
                  "if (body.slug) {",
                  "  pm.collectionVariables.set(\"project_slug\", body.slug);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"slug\": \"{{project_slug}}\",\n  \"title\": \"Sample Portfolio Project\",\n  \"summary\": \"A project created from Postman.\",\n  \"description\": \"Use this request to create a project through the API.\",\n  \"body\": \"Long-form project details can go here.\",\n  \"tech_stack\": [\n    \"Go\",\n    \"PostgreSQL\"\n  ],\n  \"tags\": [\n    \"api\",\n    \"portfolio\"\n  ],\n  \"main_image\": {\n    \"url\": \"https://example.com/images/sample-main.jpg\",\n    \"alt_text\": \"Sample main image\",\n    \"caption\": \"Sample image\",\n    \"sort_order\": 0\n  },\n  \"github_url\": \"https://github.com/example/project\",\n  \"demo_url\": \"https://example.com/project\",\n  \"featured\": true,\n  \"sort_order\": 10,\n  \"status\": \"draft\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/projects",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "projects"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Get Project by ID",
          "request": {
            "method": "GET",
